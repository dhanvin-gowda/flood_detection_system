{
  "name": "flood_detection_system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "python -m uvicorn backend.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:all": "concurrently -n web,api -c cyan,magenta -k \"pnpm dev\" \"pnpm run dev:api\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/patch-geocoding.cjs"
  },
  "dependencies": {
